<!-- Automatisch erzeugt aus design/tokens.json durch tools/generate_theme.py. Nicht von Hand ändern. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Dark Mode -->
    <Color x:Key="CanvasColor">#FF0B121A</Color>
    <SolidColorBrush x:Key="CanvasBrush" Color="#FF0B121A" />
    <Color x:Key="Surface1Color">#FF111C27</Color>
    <SolidColorBrush x:Key="Surface1Brush" Color="#FF111C27" />
    <Color x:Key="Surface2Color">#FF172431</Color>
    <SolidColorBrush x:Key="Surface2Brush" Color="#FF172431" />
    <Color x:Key="BorderColor">#FF293847</Color>
    <SolidColorBrush x:Key="BorderBrush" Color="#FF293847" />
    <Color x:Key="TextColor">#FFF3F6F9</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#FFF3F6F9" />
    <Color x:Key="TextSecondaryColor">#FF9EACBA</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9EACBA" />
    <Color x:Key="AccentColor">#FF3395E8</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3395E8" />
    <Color x:Key="SuccessColor">#FF43B96C</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF43B96C" />
    <Color x:Key="WarningColor">#FFF0AE32</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF0AE32" />
    <Color x:Key="CriticalColor">#FFE85C5C</Color>
    <SolidColorBrush x:Key="CriticalBrush" Color="#FFE85C5C" />
    <Color x:Key="OnAccentColor">#FF0B121A</Color>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF0B121A" />
    <!-- Logo für Inhaltsflächen dieses Modus -->
    <BitmapImage x:Key="LogoContentImage" UriSource="pack://application:,,,/EGLE360.PLAN;component/Assets/EGLE360_Master_Light_HighContrast_8192.png" DecodePixelHeight="512" CacheOption="OnLoad" />
    <sys:String x:Key="LogoContentName">Master Light HighContrast</sys:String>
</ResourceDictionary>
