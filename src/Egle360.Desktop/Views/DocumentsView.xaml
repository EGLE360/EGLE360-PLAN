<UserControl x:Class="Egle360.Desktop.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pdf="clr-namespace:Egle360.Pdf;assembly=Egle360.Pdf"
             xmlns:local="clr-namespace:Egle360.Desktop.Views"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <UserControl.Resources>
        <local:FileNameConverter x:Key="FileNameConverter" />
        <Style x:Key="ListHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ListCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->
        <Border Grid.Row="0" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButton}" Content="&#xE8E5;" Click="OnOpen" ToolTip="PDF öffnen (Strg+O)" AutomationProperties.Name="PDF öffnen" />
                <Button Style="{StaticResource ToolButton}" Content="&#xE8A5;" Click="OnNew" ToolTip="Neues PDF (Strg+N)" AutomationProperties.Name="Neues PDF" />
                <Button x:Name="SaveButton" Style="{StaticResource ToolButton}" Content="&#xE74E;" Click="OnSave" ToolTip="Speichern (Strg+S)" AutomationProperties.Name="Speichern" />
                <Button x:Name="SaveAsButton" Style="{StaticResource ToolButton}" Content="&#xE792;" Click="OnSaveAs" ToolTip="Speichern unter (Strg+Umschalt+S)" AutomationProperties.Name="Speichern unter" />
                <Button x:Name="PrintButton" Style="{StaticResource ToolButton}" Content="&#xE749;" Click="OnPrint" ToolTip="Drucken (Strg+P)" AutomationProperties.Name="Drucken" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button x:Name="SidebarButton" Style="{StaticResource ToolButton}" Content="&#xE89F;" Click="OnToggleSidebar" ToolTip="Seitenleiste ein- oder ausblenden" AutomationProperties.Name="Seitenleiste" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button x:Name="ZoomOutButton" Style="{StaticResource ToolButton}" Content="&#xE71F;" Click="OnZoomOut" ToolTip="Verkleinern (Strg+Minus)" AutomationProperties.Name="Verkleinern" />
                <TextBox x:Name="ZoomBox" Style="{StaticResource InputBox}" Width="64" TextAlignment="Right" KeyDown="OnZoomBoxKey"
                         ToolTip="Zoom in Prozent, mit Eingabetaste übernehmen" AutomationProperties.Name="Zoom in Prozent" />
                <Button x:Name="ZoomInButton" Style="{StaticResource ToolButton}" Content="&#xE8A3;" Click="OnZoomIn" ToolTip="Vergrößern (Strg+Plus)" AutomationProperties.Name="Vergrößern" />
                <Button x:Name="FitWidthButton" Style="{StaticResource ToolButton}" Content="&#xE9A6;" Click="OnFitWidth" ToolTip="An Breite anpassen (Strg+2)" AutomationProperties.Name="An Breite anpassen" />
                <Button x:Name="FitPageButton" Style="{StaticResource ToolButton}" Content="&#xE9A8;" Click="OnFitPage" ToolTip="Ganze Seite (Strg+0)" AutomationProperties.Name="Ganze Seite" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button x:Name="PrevButton" Style="{StaticResource ToolButton}" Content="&#xE70E;" Click="OnPrevPage" ToolTip="Vorherige Seite (Bild auf)" AutomationProperties.Name="Vorherige Seite" />
                <TextBox x:Name="PageBox" Style="{StaticResource InputBox}" Width="48" TextAlignment="Right" KeyDown="OnPageBoxKey"
                         ToolTip="Seitenzahl, mit Eingabetaste springen" AutomationProperties.Name="Seitenzahl" />
                <TextBlock x:Name="PageCountText" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0" />
                <Button x:Name="NextButton" Style="{StaticResource ToolButton}" Content="&#xE70D;" Click="OnNextPage" ToolTip="Nächste Seite (Bild ab)" AutomationProperties.Name="Nächste Seite" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button x:Name="RotateLeftButton" Style="{StaticResource ToolButton}" Click="OnRotateLeft" ToolTip="Seite nach links drehen" AutomationProperties.Name="Seite nach links drehen">
                    <TextBlock Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><ScaleTransform ScaleX="-1" /></TextBlock.RenderTransform></TextBlock>
                </Button>
                <Button x:Name="RotateRightButton" Style="{StaticResource ToolButton}" Content="&#xE7AD;" Click="OnRotateRight" ToolTip="Seite nach rechts drehen" AutomationProperties.Name="Seite nach rechts drehen" />
                <Button x:Name="InsertBlankButton" Style="{StaticResource ToolButton}" Content="&#xE710;" Click="OnInsertBlank" ToolTip="Leere Seite nach der aktuellen einfügen" AutomationProperties.Name="Leere Seite einfügen" />
                <Button x:Name="InsertFileButton" Style="{StaticResource ToolButton}" Content="&#xE8F4;" Click="OnInsertFromFile" ToolTip="Seiten aus anderem PDF einfügen (Zusammenführen)" AutomationProperties.Name="Seiten aus Datei einfügen" />
                <Button x:Name="ExtractButton" Style="{StaticResource ToolButton}" Content="&#xE8B5;" Click="OnExtract" ToolTip="Seiten als neues PDF speichern (Aufteilen)" AutomationProperties.Name="Seiten herauslösen" />
                <Button x:Name="DeletePageButton" Style="{StaticResource ToolButton}" Content="&#xE74D;" Click="OnDeletePage" ToolTip="Aktuelle Seite löschen" AutomationProperties.Name="Seite löschen" />
                <Border Style="{StaticResource ToolSeparator}" />
                <Button x:Name="PropertiesButton" Style="{StaticResource ToolButton}" Content="&#xE946;" Click="OnProperties" ToolTip="Dokumenteigenschaften" AutomationProperties.Name="Dokumenteigenschaften" />
                <Button x:Name="MarkupListButton" Style="{StaticResource ToolButton}" Content="&#xE8FD;" Click="OnToggleMarkupList" ToolTip="Markierungs- und Mengenliste ein- oder ausblenden" AutomationProperties.Name="Markierungsliste" />
            </WrapPanel>
        </Border>

        <!-- Markierungen -->
        <Border Grid.Row="1" x:Name="MarkupBarBorder" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,2">
            <WrapPanel x:Name="MarkupBar" VerticalAlignment="Center" />
        </Border>

        <!-- Registerkarten -->
        <Border Grid.Row="2" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                x:Name="TabStripBorder">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
            </ScrollViewer>
        </Border>

        <!-- Arbeitsbereich -->
        <Grid Grid.Row="3" x:Name="WorkArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="140" MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource Surface1Brush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <UniformGrid Rows="1" Margin="4,4,4,0">
                        <RadioButton x:Name="PagesTab" Style="{StaticResource SegmentButton}" IsChecked="True" GroupName="Sidebar" Checked="OnSidebarTab">
                            <Viewbox StretchDirection="DownOnly"><TextBlock Text="Seiten" /></Viewbox>
                        </RadioButton>
                        <RadioButton x:Name="BookmarksTab" Style="{StaticResource SegmentButton}" GroupName="Sidebar" Checked="OnSidebarTab">
                            <Viewbox StretchDirection="DownOnly"><TextBlock Text="Lesezeichen" /></Viewbox>
                        </RadioButton>
                        <RadioButton x:Name="SearchTab" Style="{StaticResource SegmentButton}" GroupName="Sidebar" Checked="OnSidebarTab"
                                     ToolTip="Text im Dokument suchen (Strg+F)">
                            <Viewbox StretchDirection="DownOnly"><TextBlock Text="Suche" /></Viewbox>
                        </RadioButton>
                    </UniformGrid>
                    <ListBox x:Name="Thumbnails" Grid.Row="1" Style="{StaticResource PlainList}" SelectionChanged="OnThumbnailSelected"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             AutomationProperties.Name="Seitenminiaturen">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Nach rechts drehen" Click="OnRotateRight" />
                                <MenuItem Header="Nach links drehen" Click="OnRotateLeft" />
                                <Separator />
                                <MenuItem Header="Nach oben verschieben" Click="OnMoveUp" />
                                <MenuItem Header="Nach unten verschieben" Click="OnMoveDown" />
                                <Separator />
                                <MenuItem Header="Leere Seite danach einfügen" Click="OnInsertBlank" />
                                <MenuItem Header="Seite als neues PDF speichern" Click="OnExtract" />
                                <Separator />
                                <MenuItem Header="Seite löschen" Click="OnDeletePage" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Loaded="OnThumbnailLoaded">
                                    <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                        <Image Source="{Binding Image}" Width="{Binding Width}" Height="{Binding Height}" Stretch="Fill" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TreeView x:Name="Bookmarks" Grid.Row="1" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                              SelectedItemChanged="OnBookmarkSelected" Padding="4" AutomationProperties.Name="Lesezeichen">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type pdf:PdfBookmark}" ItemsSource="{Binding Children}">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource TextBody}" TextWrapping="NoWrap" Margin="0,2" />
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <DockPanel x:Name="SearchPanel" Grid.Row="1" Visibility="Collapsed" Margin="8">
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource InputBox}" KeyDown="OnSearchBoxKey"
                                 ToolTip="Suchbegriff, Eingabetaste startet die Suche. F3 springt zur nächsten Fundstelle."
                                 AutomationProperties.Name="Suchbegriff" />
                        <TextBlock x:Name="SearchStatus" DockPanel.Dock="Top" Style="{StaticResource TextCaption}" Margin="2,6,2,6" TextWrapping="Wrap"
                                   Text="Begriff eingeben und mit der Eingabetaste suchen. Gescannte Pläne ohne Textebene enthalten keinen durchsuchbaren Text." />
                        <ListBox x:Name="SearchResults" Style="{StaticResource PlainList}" SelectionChanged="OnSearchResultSelected"
                                 VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Suchergebnisse">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,3">
                                        <TextBlock Style="{StaticResource TextCaption}" Text="{Binding PageLabel}" />
                                        <TextBlock Style="{StaticResource TextBody}" Text="{Binding Context}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <TextBlock x:Name="NoBookmarks" Grid.Row="1" Style="{StaticResource TextSecondary}" Margin="16" Visibility="Collapsed"
                               Text="Dieses Dokument enthält keine Lesezeichen." />
                </Grid>
            </Border>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitterMoved" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="MarkupListRow" Height="0" MinHeight="0" />
                </Grid.RowDefinitions>
                <ContentControl x:Name="ViewerHost" Focusable="False" />
                <GridSplitter x:Name="MarkupListSplitter" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Visibility="Collapsed"
                              Background="{DynamicResource BorderBrush}" ResizeBehavior="PreviousAndNext" />
                <DockPanel x:Name="MarkupListPanel" Grid.Row="2" Background="{DynamicResource Surface1Brush}" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="8,6" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="&#xE711;" Click="OnToggleMarkupList" ToolTip="Liste schließen" AutomationProperties.Name="Liste schließen" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource ButtonSecondary}" Content="Exportieren (Excel) …" Click="OnExportMarkups" Margin="8,0" VerticalAlignment="Center"
                                ToolTip="Liste als CSV-Datei mit Semikolon speichern; öffnet sich direkt in Excel" />
                        <CheckBox x:Name="MeasurementsOnly" DockPanel.Dock="Right" Content="Nur Messungen" VerticalAlignment="Center" Margin="8,0"
                                  Foreground="{DynamicResource TextBrush}" Click="OnMarkupListFilter" />
                        <TextBox x:Name="MarkupFilter" DockPanel.Dock="Left" Style="{StaticResource InputBox}" Width="180" VerticalAlignment="Center" TextChanged="OnMarkupListFilter"
                                 ToolTip="Filtern nach Art, Text oder Autor" AutomationProperties.Name="Markierungen filtern" />
                    </DockPanel>
                    <TextBlock x:Name="MarkupTotals" DockPanel.Dock="Top" Style="{StaticResource TextSecondary}" Margin="12,0,12,6"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <DataGrid x:Name="MarkupGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" CanUserResizeRows="False" BorderThickness="0,1,0,0" Background="Transparent"
                              BorderBrush="{DynamicResource BorderBrush}" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              ColumnHeaderStyle="{StaticResource ListHeader}" CellStyle="{StaticResource ListCell}" RowStyle="{StaticResource ListRow}"
                              SelectionChanged="OnMarkupRowSelected" AutomationProperties.Name="Markierungsliste">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Seite" Binding="{Binding Page}" Width="58" />
                            <DataGridTextColumn Header="Art" Binding="{Binding Kind}" Width="100" />
                            <DataGridTextColumn Header="Wert" Binding="{Binding Value}" Width="160" SortMemberPath="Number" />
                            <DataGridTextColumn Header="Preis" Binding="{Binding CostText}" Width="100" SortMemberPath="Cost" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="120" SortMemberPath="Status" />
                            <DataGridTextColumn Header="Text oder Kommentar" Binding="{Binding Text}" Width="*" MinWidth="160" />
                            <DataGridTextColumn Header="Maßstab" Binding="{Binding Scale}" Width="110" />
                            <DataGridTextColumn Header="Autor" Binding="{Binding Author}" Width="110" />
                            <DataGridTextColumn Header="Geändert" Binding="{Binding Modified}" Width="120" SortMemberPath="ModifiedValue" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Leerer Zustand -->
        <Grid x:Name="EmptyState" Grid.Row="1" Grid.RowSpan="3" Background="{DynamicResource CanvasBrush}">
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextTitle}" Text="Kein Dokument geöffnet" />
                    <TextBlock Style="{StaticResource TextSecondary}" Margin="0,6,0,16"
                               Text="PDF-Pläne öffnen oder per Ziehen und Ablegen in dieses Fenster laden. Mehrere Dokumente erscheinen als Registerkarten." />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ButtonPrimary}" Content="PDF öffnen" Click="OnOpen" />
                        <Button Style="{StaticResource ButtonSecondary}" Content="Neues PDF" Click="OnNew" Margin="8,0,0,0" />
                        <Button Style="{StaticResource ButtonSecondary}" Content="Beispielplan öffnen" Click="OnOpenSample" Margin="8,0,0,0"
                                ToolTip="Frei erfundener Grundriss mit Beispielmarkierungen zum Ausprobieren" />
                    </StackPanel>
                    <TextBlock x:Name="RecentTitle" Style="{StaticResource TextSubtitle}" Text="Zuletzt geöffnet" Margin="0,24,0,8" />
                    <ItemsControl x:Name="RecentList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnOpenRecent" Tag="{Binding}" Cursor="Hand" HorizontalContentAlignment="Left" Margin="0,1"
                                        ToolTip="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusSmall}" Padding="8,5">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource TextBody}" Text="{Binding Converter={StaticResource FileNameConverter}}" />
                                                    <TextBlock Style="{StaticResource TextCaption}" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Statuszeile -->
        <Border Grid.Row="4" Background="{DynamicResource Surface1Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock x:Name="StatusZoom" DockPanel.Dock="Right" Style="{StaticResource TextCaption}" Margin="16,0,0,0" />
                <TextBlock x:Name="StatusMarkup" DockPanel.Dock="Right" Style="{StaticResource TextCaption}" Margin="16,0,0,0" />
                <TextBlock x:Name="StatusFormat" DockPanel.Dock="Right" Style="{StaticResource TextCaption}" Margin="16,0,0,0" />
                <TextBlock x:Name="StatusPath" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
